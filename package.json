{
  "name": "yosadraw",
  "version": "1.11.0",
  "private": true,
  "type": "module",
  "description": "YOSADRAW: aplicación de dibujo con motor de pinceles y estabilizador de trazos",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && node scripts/ffmpeg-win.mjs && electron-builder --win nsis portable --x64",
    "dist:win:dir": "npm run build && node scripts/ffmpeg-win.mjs && electron-builder --win dir --x64",
    "artifact": "node scripts/build-artifact.mjs index.html yosadraw.html YOSADRAW && node scripts/build-artifact.mjs lab.html trazo-estable.html \"Trazo Estable\"",
    "dist:win:zip": "npm run build && node scripts/ffmpeg-win.mjs && electron-builder --win zip --x64",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "apk:debug": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@jsquash/webp": "1.5.0",
    "ag-psd": "34.1.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "fflate": "0.8.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "productName": "YOSADRAW",
  "author": "YOSADRAW",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.yosadraw.app",
    "productName": "YOSADRAW",
    "copyright": "© 2026 YOSADRAW",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/@capacitor/**",
      "!node_modules/@ffmpeg-installer/**",
      "!desktop/FFMPEG-LICENSE.txt"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "YOSADRAW",
      "extraResources": [
        {
          "from": "node_modules/@ffmpeg-installer/win32-x64",
          "to": "ffmpeg",
          "filter": [
            "ffmpeg.exe"
          ]
        },
        {
          "from": "desktop/FFMPEG-LICENSE.txt",
          "to": "ffmpeg/LICENSE.txt"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YOSADRAW",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "YOSADRAW-Setup-${version}-x64.${ext}"
    },
    "portable": {
      "artifactName": "YOSADRAW-${version}-x64-portable.${ext}"
    },
    "publish": null
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.4.3",
    "gifenc": "^1.0.3",
    "mp4-muxer": "^5.2.2"
  }
}

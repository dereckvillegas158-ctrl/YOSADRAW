; Archivo de configuración del proyecto de Godot 4.

config_version=5

[application]

config/name="Tactico"
config/description="Base de un shooter táctico en primera persona, ligero y realista."
run/main_scene="res://escenas/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Controles="*res://scripts/controles.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="jugador"
3d_physics/layer_3="enemigos"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
